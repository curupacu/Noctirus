# Config do Web App do Firebase (Firebase Console > Configurações do projeto > Seus apps > SDK setup)
VITE_FIREBASE_API_KEY=
# Deixe o *.firebaseapp.com padrão — trocar pro domínio próprio quebra o login com Google
# (as URLs reservadas /__/auth/** não são servidas certo em domínio customizado aqui,
# testado em 29/08/2026). O bug de sessão sumindo em PWA/mobile tem outra causa, ainda
# sem solução confirmada.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL do backend (local: http://localhost:3001)
VITE_API_URL=http://localhost:3001

# DSN do Sentry (sentry.io > Settings > Projects > frontend > Client Keys) — opcional,
# sem ela o app roda normal só sem reportar erro pra lugar nenhum.
VITE_SENTRY_DSN=
