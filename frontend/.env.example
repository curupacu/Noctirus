# Config do Web App do Firebase (Firebase Console > Configurações do projeto > Seus apps > SDK setup)
VITE_FIREBASE_API_KEY=
# Use o domínio próprio (ex.: nocturis.com.br), não o *.firebaseapp.com padrão que o
# Firebase sugere — com domínios diferentes o login pode "sumir" ao fechar e reabrir o
# site/PWA (bloqueio de storage entre domínios). Precisa estar autorizado em
# Authentication > Settings > Authorized domains.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL do backend (local: http://localhost:3001)
VITE_API_URL=http://localhost:3001

# DSN do Sentry (sentry.io > Settings > Projects > frontend > Client Keys) — opcional,
# sem ela o app roda normal só sem reportar erro pra lugar nenhum.
VITE_SENTRY_DSN=
