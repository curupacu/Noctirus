rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Nega tudo por padrão (RNF005). Papéis vêm de custom claims, nunca de campo público.
    // Na prática, toda leitura/escrita de dados sensíveis passa pelo backend (Admin SDK,
    // que ignora estas rules) — elas ficam como segunda camada de defesa caso o front
    // algum dia leia/escreva Firestore direto.
    match /{document=**} {
      allow read, write: if false;
    }

    function papel() {
      return request.auth.token.role;
    }

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Só o dono e o admin leem — o doc tem email/telefone (LGPD). Antes qualquer usuário
      // logado lia o doc de qualquer outro, o que vazava dado pessoal de todo mundo pra
      // quem quisesse ler direto pelo SDK do cliente.
      allow read: if dono(uid) || papel() == "admin";
      allow create: if dono(uid);
      // Edição não pode trocar papel nem status — role só muda via custom claim (backend)
      // e status só pelo backend/admin.
      allow update: if papel() == "admin" ||
        (dono(uid) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status);
    }

    match /advogados/{uid} {
      allow read: if true;
      // O dono só pode mexer nos campos que o backend também deixa (áreas, especialidades,
      // localização, contato) — nunca na situação da OAB nem na "oab". Sem essa trava, um
      // advogado conseguia se auto-aprovar (`situacaoOab: "aprovado"`) escrevendo direto no Firestore pelo
      // SDK do cliente, sem passar pelo backend — as chaves do Firebase web são públicas
      // por design, "só o backend faz isso" não protege nada se a rule não travar também.
      allow create, delete: if papel() == "admin";
      allow update: if papel() == "admin" ||
        (dono(uid) && papel() == "advogado" &&
          request.resource.data.situacaoOab == resource.data.situacaoOab &&
          request.resource.data.situacaoOabMotivo == resource.data.situacaoOabMotivo &&
          request.resource.data.situacaoOabPor == resource.data.situacaoOabPor &&
          request.resource.data.oab == resource.data.oab);
    }

    match /curriculos/{uid} {
      allow read: if true;
      allow write: if dono(uid) && papel() == "advogado";
    }

    // Triagem só é criada/lida pelo backend (classificação por IA/regras + matching);
    // aqui fica só como segunda camada, liberando leitura pro próprio cliente dono.
    match /triagens/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.clienteId;
      allow write: if false;
    }

    // Pedido de contato (RF010/RF013/RF014): só o backend cria e responde (precisa validar
    // autorização, aprovação da OAB e duplicidade); o cliente e o advogado do pedido leem.
    match /solicitacoes/{id} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.clienteId ||
         request.auth.uid == resource.data.advogadoId ||
         papel() == "admin");
      allow write: if false;
    }

    // Notificação em tempo real (sininho) — só o backend cria (ver routes/solicitacoes.js
    // e routes/advogados.js), o frontend lê direto do Firestore com onSnapshot (sem round-trip
    // pela API a cada notificação nova) e só pode marcar como lida, nunca mudar o conteúdo.
    match /notificacoes/{id} {
      allow read: if dono(resource.data.destinatarioId);
      allow update: if dono(resource.data.destinatarioId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lida"]);
      allow create, delete: if false;
    }
  }
}
