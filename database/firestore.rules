rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Nega tudo por padrão (RNF005). Papéis vêm de custom claims, nunca de campo público.
    // Na prática, toda leitura/escrita de dados sensíveis passa pelo backend (Admin SDK,
    // que ignora estas rules) — elas ficam como segunda camada de defesa caso o front
    // algum dia leia/escreva Firestore direto.
    match /{document=**} {
      allow read, write: if false;
    }

    function papel() {
      return request.auth.token.role;
    }

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // users, advogados e currículos: o site nunca lê nem grava essas coleções direto, tudo passa
    // pelo backend (Admin SDK, que ignora as rules). Por isso ficam fechadas para o cliente:
    // antes `advogados` tinha leitura pública (vazava WhatsApp/e-mail que só deveriam aparecer
    // depois do aceite, RF010) e o dono podia gravar campos sem a validação do backend
    // (bio sem limite, foto de fora, e-mail de notificação trocado). Achado da auditoria de 11/2026.
    match /users/{uid} {
      allow read: if dono(uid) || papel() == "admin";
      allow write: if false;
    }

    match /advogados/{uid} {
      allow read, write: if false;
    }

    match /curriculos/{uid} {
      allow read, write: if false;
    }

    // Triagem só é criada/lida pelo backend (classificação por IA/regras + matching);
    // aqui fica só como segunda camada, liberando leitura pro próprio cliente dono.
    match /triagens/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.clienteId;
      allow write: if false;
    }

    // Pedido de contato (RF010/RF013/RF014): só o backend cria, responde e lê. Fechado pro
    // cliente porque o documento também guarda as anotações privadas do advogado (que o
    // backend nunca devolve pro cliente) e porque advogado com OAB revogada não pode ler
    // pedidos pendentes. O site não lê essa coleção direto.
    match /solicitacoes/{id} {
      allow read, write: if false;
    }

    // Notificação em tempo real (sininho) — só o backend cria (ver routes/solicitacoes.js
    // e routes/advogados.js), o frontend lê direto do Firestore com onSnapshot (sem round-trip
    // pela API a cada notificação nova) e só pode marcar como lida, nunca mudar o conteúdo.
    match /notificacoes/{id} {
      allow read: if dono(resource.data.destinatarioId);
      allow update: if dono(resource.data.destinatarioId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lida"]);
      allow create, delete: if false;
    }
  }
}
